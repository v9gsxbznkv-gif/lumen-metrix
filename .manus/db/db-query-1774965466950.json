  "query": "-- This is what the Events page sums for the monthly estimate\n-- Easter = April, Mother's Day = May, Back to School = August, Christmas = December\nSELECT year, month, subgroup, campus, avgWeekly\nFROM attendance_monthly \nWHERE month IN (4, 5, 8, 12) \n  AND subgroup IN ('Adults', 'Kids', 'Students', 'Young Adults')\n  AND campus IN ('Canton', 'Jasper')\nORDER BY year DESC, month, campus, subgroup\nLIMIT 60",
